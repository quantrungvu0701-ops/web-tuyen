# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local state (machine-specific; .claude/launch.json is still tracked)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Agent tooling — restorable via skills-lock.json (`npx skills add`), ~17MB of
# downloaded binaries that don't belong in the site repo.
.claude/skills/
.agents/
